static func apply(p: Dictionary) -> void:
	var key: String = str(p.get("base", p.id))
	if not FACES.has(key): return
	var f: Array = FACES[key]
	var face: Dictionary = p.get("face", {}).duplicate()
	face.skin = f[0]; face.hair = f[1]; face.hairC = f[2]; face.beard = f[3]
	if not face.has("brow"): face.brow = 1
	p.face = face
