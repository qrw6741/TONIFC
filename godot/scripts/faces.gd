## everyone else: a believable look for their nationality (deterministic per player, so special cards match)
const NORTH := ["NOR", "SWE", "DEN", "ISL", "FIN", "EST", "LTU", "NED", "GER", "AUT", "SUI", "POL", "CZE", "SVK", "SVN", "HUN", "UKR", "RUS", "IRL", "SCO", "WAL", "NIR", "ENG", "CRO", "SRB", "BIH", "MNE", "MKD", "KOS", "ROU", "BEL", "LUX", "NZL", "AUS", "GEO", "ARM", "UZB", "CAN", "USA", "FRA"]
const SOUTH := ["ESP", "POR", "ITA", "GRE", "TUR", "ALB", "CYP", "MEX", "CHI", "URU", "ARG", "PAR"]
const WEST_AFRICA := ["SEN", "CIV", "NGA", "GHA", "CMR", "MLI", "COD", "BFA", "ANG", "GUI", "GAM", "ZIM", "BEN", "GAB", "TOG", "CTA", "NIG", "EQG", "ZAM", "SLE", "GNB", "MAD", "MOZ", "RSA", "CAF", "JAM", "HAI", "DOM", "GUF", "CPV", "HON", "PAN"]
const MAGHREB := ["MAR", "ALG", "TUN", "EGY", "LBY", "JOR"]
const LATIN := ["BRA", "COL", "ECU", "VEN"]
const ASIA := ["JPN", "KOR", "IDN"]
## share of players of African/Caribbean heritage in mixed squads
const MIXED := {"FRA": 0.45, "ENG": 0.3, "NED": 0.3, "BEL": 0.3, "SUI": 0.15, "GER": 0.15, "POR": 0.15, "ESP": 0.07, "ITA": 0.07, "SWE": 0.12, "DEN": 0.08, "NOR": 0.12, "AUT": 0.1, "IRL": 0.08, "USA": 0.35, "CAN": 0.4, "AUS": 0.08}

static func _w(rng: RandomNumberGenerator, opts: Array, weights: Array):
	var tot = 0.0
	for x in weights: tot += x
	var r = rng.randf() * tot
	for i in opts.size():
		r -= weights[i]
		if r <= 0: return opts[i]
	return opts[-1]

static func generate(key: String, nat: String, age: int) -> Array:
	var rng = RandomNumberGenerator.new(); rng.seed = hash(key + "face")
	var group = "south"
	if NORTH.has(nat): group = "north"
	elif WEST_AFRICA.has(nat): group = "africa"
	elif MAGHREB.has(nat): group = "maghreb"
	elif LATIN.has(nat): group = "latin"
	elif ASIA.has(nat): group = "asia"
	if (group == "north" or group == "south") and rng.randf() < float(MIXED.get(nat, 0.0)): group = "africa"
	if group == "latin": group = _w(rng, ["south", "maghreb", "africa"], [45, 30, 25])
	var skin: int; var hair: int; var col: int
	match group:
		"north":
			skin = _w(rng, [0, 1], [70, 30]); col = _w(rng, [0, 1, 2, 3, 4, 5], [6, 22, 30, 20, 14, 8])
			hair = _w(rng, [0, 1, 2, 6, 9, 3, 11, 7], [28, 26, 14, 12, 8, 5, 3, 4])
		"south":
			skin = _w(rng, [0, 1, 2], [20, 55, 25]); col = _w(rng, [0, 1, 2, 3], [40, 38, 17, 5])
			hair = _w(rng, [0, 1, 2, 6, 9, 3, 11, 7], [26, 26, 12, 12, 10, 6, 4, 4])
		"africa":
			skin = _w(rng, [4, 5, 6, 7], [10, 25, 40, 25]); col = _w(rng, [0, 7, 5], [90, 6, 4])
			hair = _w(rng, [2, 12, 4, 10, 7, 5], [40, 20, 8, 10, 16, 6])
		"maghreb":
			skin = _w(rng, [2, 3, 4], [35, 45, 20]); col = _w(rng, [0, 1], [75, 25])
			hair = _w(rng, [0, 1, 2, 6, 9, 7], [22, 26, 18, 12, 10, 12])
		"asia":
			skin = _w(rng, [1, 2], [50, 50]); col = _w(rng, [0, 1, 4], [80, 14, 6])
			hair = _w(rng, [0, 1, 6, 2], [30, 35, 25, 10])
		_:
			skin = 1; col = 1; hair = 0
	var older: bool = age >= 29
	var beard: int = _w(rng, [0, 1, 5, 2, 4], [30, 30, 22, 10, 8] if older else [55, 26, 11, 4, 4])
	return [skin, hair, col, beard]

static func apply(p: Dictionary) -> void:
	var key: String = str(p.get("base", p.id))
	var f: Array = FACES[key] if FACES.has(key) else generate(key, str(p.get("nat", "")), int(p.get("age", 26)))
	var face: Dictionary = p.get("face", {}).duplicate()
	face.skin = f[0]; face.hair = f[1]; face.hairC = f[2]; face.beard = f[3]
	if not face.has("brow"): face.brow = 1
	p.face = face
